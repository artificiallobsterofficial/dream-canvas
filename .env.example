# AI Provider — set one (or both; Anthropic is preferred when both are present).
# The app works fully without any key: AI features fall back to built-in local responses.
#
# WARNING: in a browser-only app these keys are visible to anyone who opens dev tools.
# Fine for personal/local use — do NOT deploy a build containing real keys to a public URL.
VITE_ANTHROPIC_API_KEY=
VITE_GEMINI_API_KEY=

# Optional model overrides
VITE_ANTHROPIC_MODEL=claude-opus-4-8
VITE_GEMINI_MODEL=gemini-2.5-flash

# Serverless proxy (worker/ in this repo) — safe to bake into public builds,
# since the AI key lives on the worker, not in the bundle. Enables live AI
# without a key, tester feedback, and cloud backup. See worker/DEPLOY.md.
# In CI this comes from the AI_PROXY_URL repository variable.
VITE_AI_PROXY_URL=
